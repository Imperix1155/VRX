#!/bin/sh
# VRX pre-commit hook (VRX-153): block secrets before they are committed.
#
# CI is the authoritative gate; this is a fast local early-catch. In a genuine
# emergency you can bypass with `git commit --no-verify`, but CI will still scan.
# Wired in via `core.hooksPath` (set by the `prepare` npm script on install).
#
# Two scans of the staged changes:
#   1. scripts/check-secrets.mjs, which needs only Node and always runs.
#   2. gitleaks, the fuller ruleset, when it is installed.

root=$(git rev-parse --show-toplevel) || exit 1

if command -v node >/dev/null 2>&1; then
  if ! node "$root/scripts/check-secrets.mjs" --staged; then
    echo
    echo "vrx: the secret check stopped this commit (its output is above)."
    echo "vrx: if it lists a line, remove the value or use a stand-in before committing;"
    echo "vrx: scripts/check-secrets.mjs explains test values and paths."
    exit 1
  fi
else
  echo "vrx: node not found; skipping the built-in secret scan (CI will still scan)."
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "vrx: gitleaks not found; ran the built-in scan only (CI runs gitleaks too)."
  echo "vrx: install it for the fuller local scan:"
  echo "vrx:   https://github.com/gitleaks/gitleaks#installing"
  exit 0
fi

if ! gitleaks git --staged --redact --no-banner; then
  echo
  echo "vrx: gitleaks found a potential secret in your staged changes (above)."
  echo "vrx: remove it, or, if it is a confirmed false positive, allowlist the"
  echo "vrx: exact value (not the path) in .gitleaks.toml with a comment."
  exit 1
fi
