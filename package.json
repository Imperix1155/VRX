{
  "name": "vrx",
  "desktopName": "com.imperix.vrx",
  "version": "0.19.1",
  "description": "VRX — Social VR companion for VRChat + ChilloutVR",
  "main": "./out/main/index.js",
  "author": "Imperix1155",
  "homepage": "https://github.com/Imperix1155/VRX",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache --max-warnings 0 .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:credential-persistence-probe": "electron-vite build --config electron-vite.credential-probe.config.ts",
    "test:credential-persistence-linux": "sh -c 'if [ \"$#\" -ne 1 ]; then printf \"%s\\n\" ASSERT_ARGUMENTS >&2; exit 1; fi; npm run build:credential-persistence-probe && ./node_modules/.bin/electron out/credential-probe/index.js write \"$1\" && ./node_modules/.bin/electron out/credential-probe/index.js read \"$1\"' --",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && node scripts/assert-entry-chunk.mjs",
    "postinstall": "electron-builder install-app-deps",
    "prepare": "git config core.hooksPath scripts/git-hooks || true",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@tanstack/query-sync-storage-persister": "^5.102.2",
    "@tanstack/react-query": "^5.102.2",
    "@tanstack/react-query-persist-client": "^5.102.2",
    "@tanstack/react-virtual": "^3.14.10",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "i18next": "^26.4.0",
    "ps-list": "^9.0.0",
    "react-i18next": "^17.0.12",
    "saxes": "6.0.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "^4.3.0",
    "@noble/hashes": "2.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "app-builder-lib": "^26.15.7",
    "builder-util": "^26.15.3",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "js-yaml": "^4.3.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.8.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.2.6",
    "vitest": "^4.1.8"
  }
}
